STEWARDMESH_REPOSITORY_DRIVER=postgres
STEWARDMESH_DATABASE_URL=postgres://stewardmesh:stewardmesh@127.0.0.1:5432/stewardmesh?sslmode=disable
STEWARDMESH_ADDR=127.0.0.1:8080
STEWARDMESH_ALLOWED_ORIGIN=http://localhost:5173
STEWARDMESH_DEV_PROXY_TARGET=http://127.0.0.1:8080
STEWARDMESH_SESSION_COOKIE_SECURE=false
STEWARDMESH_DATA_DIR=/workspaces/StewardMesh/data
STEWARDMESH_BLOB_DIR=/workspaces/StewardMesh/storage
STEWARDMESH_ORGANIZATION_ID=local-organization
STEWARDMESH_ORGANIZATION_NAME="StewardMesh Dev Container"
