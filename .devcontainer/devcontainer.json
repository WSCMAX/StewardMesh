{
  "name": "StewardMesh",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/StewardMesh",
  "forwardPorts": [5173, 8080, 5432],
  "portsAttributes": {
    "5173": {
      "label": "StewardMesh Web",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    },
    "8080": {
      "label": "StewardMesh API"
    },
    "5432": {
      "label": "PostgreSQL"
    }
  },
  "mounts": [
    "source=stewardmesh-dev-postgres-data,target=/var/lib/postgresql,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-services.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
