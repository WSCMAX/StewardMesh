# Development-only values. Replace credentials before any shared deployment.
STEWARDMESH_ADDR=127.0.0.1:8080
STEWARDMESH_ORGANIZATION_ID=local-organization
STEWARDMESH_ORGANIZATION_NAME=StewardMesh Local Organization
STEWARDMESH_DATA_DIR=./data
STEWARDMESH_BLOB_DIR=./storage
STEWARDMESH_REPOSITORY_DRIVER=postgres
STEWARDMESH_DATABASE_URL=postgres://stewardmesh:stewardmesh@localhost:5432/stewardmesh?sslmode=disable
STEWARDMESH_CACHE_DRIVER=none
STEWARDMESH_CACHE_URL=
STEWARDMESH_CACHE_KEY_SECRET=
STEWARDMESH_ALLOWED_ORIGIN=http://localhost:5173
STEWARDMESH_OIDC_ISSUER_URL=
STEWARDMESH_OIDC_CLIENT_ID=
STEWARDMESH_OIDC_CLIENT_SECRET=
STEWARDMESH_OIDC_REDIRECT_URL=
STEWARDMESH_OIDC_TRANSACTION_SECRET=
STEWARDMESH_OIDC_ADMINISTRATOR_CLAIM=
STEWARDMESH_OIDC_ADMINISTRATOR_VALUES=
STEWARDMESH_OIDC_REQUIRE_VERIFIED_EMAIL=true
STEWARDMESH_BOOTSTRAP_TOKEN=
STEWARDMESH_SESSION_COOKIE_SECURE=false
STEWARDMESH_SESSION_TTL=12h
STEWARDMESH_SEED_SYNTHETIC=false
VITE_ISSUES_URL=https://github.com/WSCMAX/StewardMesh/issues
