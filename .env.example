# Development-only values. Replace credentials before any shared deployment.
# REQ-DIRECTORY-EXPANSION-009 / experience.help: connector secrets are
# deployment-owned and the release checklist is documented under docs/deployment.
STEWARDMESH_ADDR=127.0.0.1:8080
STEWARDMESH_ORGANIZATION_ID=local-organization
STEWARDMESH_ORGANIZATION_NAME="StewardMesh Local Organization"
# Stable installation identity retained in Exchange provenance; defaults to the organization ID when omitted.
STEWARDMESH_EXCHANGE_SOURCE_SYSTEM_ID=
STEWARDMESH_DATA_DIR=./data
STEWARDMESH_STORAGE_DRIVER=local
STEWARDMESH_BLOB_DIR=./storage
STEWARDMESH_BLOB_MAXIMUM_BYTES=26214400
STEWARDMESH_BLOB_DOWNLOAD_TTL=5m
STEWARDMESH_S3_BUCKET=
STEWARDMESH_S3_REGION=
STEWARDMESH_S3_ENDPOINT_URL=
STEWARDMESH_S3_FORCE_PATH_STYLE=false
STEWARDMESH_S3_ACCESS_KEY_ID=
STEWARDMESH_S3_SECRET_ACCESS_KEY=
STEWARDMESH_S3_SESSION_TOKEN=
STEWARDMESH_S3_ROLE_ARN=
STEWARDMESH_S3_ENCRYPTION=
STEWARDMESH_S3_KMS_KEY_ID=
STEWARDMESH_REPOSITORY_DRIVER=postgres
STEWARDMESH_DATABASE_URL=postgres://stewardmesh:stewardmesh@localhost:5432/stewardmesh?sslmode=disable
STEWARDMESH_CACHE_DRIVER=none
STEWARDMESH_CACHE_URL=
STEWARDMESH_CACHE_KEY_SECRET=
# Requirement: REQ-REACH-001. Feature: messaging.delivery.
# Credential-free fixed adapter endpoints. Copy the example outside source
# control, assign one destinationKey per Teams route, and inject every env:
# reference through the deployment secret manager.
STEWARDMESH_REACH_ENDPOINTS_FILE=
STEWARDMESH_REACH_SECRET_PREFIX=STEWARDMESH_REACH_SECRET_
STEWARDMESH_ALLOWED_ORIGIN=http://localhost:5173
# Optional Vite-only override for isolated browser testing. The default is the
# backend's secure IPv4 loopback address at http://127.0.0.1:8080.
STEWARDMESH_DEV_PROXY_TARGET=http://127.0.0.1:8080
STEWARDMESH_OIDC_ISSUER_URL=
STEWARDMESH_OIDC_CLIENT_ID=
STEWARDMESH_OIDC_CLIENT_SECRET=
STEWARDMESH_OIDC_REDIRECT_URL=
STEWARDMESH_OIDC_TRANSACTION_SECRET=
STEWARDMESH_OIDC_ADMINISTRATOR_CLAIM=
STEWARDMESH_OIDC_ADMINISTRATOR_VALUES=
STEWARDMESH_OIDC_REQUIRE_VERIFIED_EMAIL=true
STEWARDMESH_SAML_IDP_METADATA_URL=
STEWARDMESH_SAML_ENTITY_ID=
STEWARDMESH_SAML_SP_CERTIFICATE_FILE=
STEWARDMESH_SAML_SP_PRIVATE_KEY_FILE=
STEWARDMESH_SAML_EMAIL_ATTRIBUTE=
STEWARDMESH_SAML_DISPLAY_NAME_ATTRIBUTE=
STEWARDMESH_SAML_ADMINISTRATOR_ATTRIBUTE=
STEWARDMESH_SAML_ADMINISTRATOR_VALUES=
# Requirement: REQ-DIRECTORY-EXPANSION-003. Feature: identity.directory.
# Optional read-only Microsoft Entra ID import. Store the client secret in the
# deployment secret manager. Grant only User.Read.All and
# GroupMember.ReadBasic.All application permissions. Add Member.Read.Hidden
# only when hidden-membership groups are explicitly in scope.
STEWARDMESH_ENTRA_SOURCE_SYSTEM_ID=entra
STEWARDMESH_ENTRA_TENANT_ID=
STEWARDMESH_ENTRA_CLIENT_ID=
STEWARDMESH_ENTRA_CLIENT_SECRET=
# Requirement: REQ-DIRECTORY-EXPANSION-004. Feature: identity.directory.
# Optional read-only SailPoint Identity Security Cloud import. Use the tenant's
# https://<tenant>.api.identitynow.com endpoint and inject a least-privilege
# client ID and secret from the deployment secret manager.
STEWARDMESH_SAILPOINT_SOURCE_SYSTEM_ID=sailpoint
STEWARDMESH_SAILPOINT_BASE_URL=
STEWARDMESH_SAILPOINT_CLIENT_ID=
STEWARDMESH_SAILPOINT_CLIENT_SECRET=
STEWARDMESH_BOOTSTRAP_TOKEN=
STEWARDMESH_SESSION_COOKIE_SECURE=false
STEWARDMESH_SESSION_TTL=12h
# Bridge derives its OAuth issuer and exact /mcp resource from ALLOWED_ORIGIN.
# Set MCP session/scopes only in the transient stdio child process; never save
# STEWARDMESH_MCP_SESSION_TOKEN in this file.
# STEWARDMESH_MCP_SCOPES=mcp:resources assets:read
# Requirements: REQ-API-001, SEC-MCP-001. Feature: integrations.protocols.
# The all-domain gRPC runtime splits authenticated methods (9090) from the three
# public Guard setup/login methods and standard gRPC health service (9091).
# Plaintext is loopback-only. Any non-loopback listener requires both TLS files,
# an HTTPS ALLOWED_ORIGIN, secure session cookies, and TLS 1.3 or newer.
STEWARDMESH_GRPC_ADDR=127.0.0.1:9090
STEWARDMESH_GRPC_PUBLIC_ADDR=127.0.0.1:9091
STEWARDMESH_GRPC_TLS_CERT_FILE=
STEWARDMESH_GRPC_TLS_KEY_FILE=
# REQ-DIRECTORY-EXPANSION-007 / platform.foundation: explicit demo-only seed.
# Enabling this requires a STEWARDMESH_ORGANIZATION_ID beginning with demo-.
STEWARDMESH_SEED_SYNTHETIC=false
# Large Riverside Community College demo (1050 employees, 15 labs, guard test users).
# Run: go run ./cmd/campus-seed with STEWARDMESH_ORGANIZATION_ID=demo-campus
STEWARDMESH_SEED_CAMPUS=false
# REQ-DIRECTORY-EXPANSION-005 / integrations.protocols: optional read-only Internet2 Grouper SCIM v2 connector. Leave URL empty to disable.
STEWARDMESH_GROUPER_URL=
STEWARDMESH_GROUPER_SOURCE_SYSTEM_ID=
STEWARDMESH_GROUPER_USERNAME=
STEWARDMESH_GROUPER_PASSWORD=
STEWARDMESH_GROUPER_BEARER_TOKEN=
STEWARDMESH_GROUPER_CONFIG_REVISION=
STEWARDMESH_GROUPER_PAGE_SIZE=100
STEWARDMESH_GROUPER_MAXIMUM_RESPONSE_BYTES=2097152
STEWARDMESH_GROUPER_TIMEOUT=15s
# Enable only for explicitly trusted private-network Grouper or the loopback fixture.
STEWARDMESH_GROUPER_ALLOW_PRIVATE_NETWORK=false
# REQ-DIRECTORY-EXPANSION-006 / integrations.protocols: optional read-only
# PeopleSoft Campus Solutions Query Access Service connector. Configure four
# dedicated JSON/NONFILE queries and inject one least-privilege credential from
# the deployment secret manager. Leave the base URL empty to disable.
STEWARDMESH_PEOPLESOFT_SOURCE_SYSTEM_ID=peoplesoft
STEWARDMESH_PEOPLESOFT_BASE_URL=
STEWARDMESH_PEOPLESOFT_USERNAME=
STEWARDMESH_PEOPLESOFT_PASSWORD=
STEWARDMESH_PEOPLESOFT_BEARER_TOKEN=
STEWARDMESH_PEOPLESOFT_QUERY_OWNER=public
STEWARDMESH_PEOPLESOFT_ORGANIZATION_QUERY=
STEWARDMESH_PEOPLESOFT_LOCATION_QUERY=
STEWARDMESH_PEOPLESOFT_BUILDING_QUERY=
STEWARDMESH_PEOPLESOFT_DEPARTMENT_QUERY=
# One strict JSON object maps each qualified QAS selector (for example,
# A.SETID) to its unqualified JSON row alias (SETID). Every object includes a
# SETID mapping. See docs/features/directory-expansion.md for the full example.
STEWARDMESH_PEOPLESOFT_FIELD_MAPPINGS_JSON=
STEWARDMESH_PEOPLESOFT_MAXIMUM_ROWS=500
STEWARDMESH_PEOPLESOFT_MAXIMUM_RESPONSE_BYTES=2097152
STEWARDMESH_PEOPLESOFT_TIMEOUT=15s
# Enable only for an explicitly trusted private-network endpoint or loopback test fixture.
STEWARDMESH_PEOPLESOFT_ALLOW_PRIVATE_NETWORK=false
# Guide public configuration. Requirements: A11Y-001, DOC-001, DOC-002. Feature: experience.help.
VITE_ISSUES_URL=https://github.com/WSCMAX/StewardMesh/issues
VITE_APP_VERSION=0.1.0
# Optional six-digit hexadecimal branding colors. Unsafe contrast falls back to the defaults.
VITE_STEWARD_DARK_CANVAS="#061827"
VITE_STEWARD_DARK_SURFACE="#0B2238"
VITE_STEWARD_LIGHT_CANVAS="#F7FAFC"
VITE_STEWARD_TEXT_ON_DARK="#F7FAFC"
VITE_STEWARD_TEXT_ON_LIGHT="#061827"
VITE_STEWARD_PRIMARY="#16BFA7"
VITE_STEWARD_SUCCESS="#168C4B"
VITE_STEWARD_WARNING="#C57900"
VITE_STEWARD_DANGER="#CC3D4A"
